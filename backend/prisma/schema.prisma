generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String    @map("password_hash")
  email        String?
  fullName     String    @map("full_name")
  role         String    @default("EMPLOYEE")
  employeeId   String?   @unique @map("employee_id")
  shiftId      Int?      @map("shift_id")
  shift        Shift?    @relation(fields: [shiftId], references: [id])
  department   String    @default("BAR")
  offDay       Int       @default(0) @map("off_day")
  isActive     Boolean   @default(true) @map("is_active")
  hourlyRate   Int       @default(0) @map("hourly_rate")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lastLoginAt  DateTime? @map("last_login_at")

  attendances   Attendance[]
  leaves        Leave[]
  schedules     UserSchedule[]
  notifications Notification[]

  sentSwaps         ShiftSwap[]      @relation("Requester")
  receivedSwaps     ShiftSwap[]      @relation("Target")
  approvedSwaps     ShiftSwap[]      @relation("ShiftSwapApprover")
  OffDayRequest     OffDayRequest[]
  receivedOffSwaps  OffDayRequest[]  @relation("OffDaySwapTarget")
  approvedOffDays   OffDayRequest[]  @relation("OffDayApprover")
  pushSubscriptions PushSubscription[]
  overtimes         Overtime[]
  approvedOvertimes Overtime[]       @relation("OvertimeApprover")

  @@index([username])
  @@index([isActive])
  @@index([role])
  @@index([shiftId])
  @@map("users")
}

model Shift {
  id        Int      @id @default(autoincrement())
  name      String
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  users     User[]
  userSchedules UserSchedule[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("shifts")
}

model Attendance {
  id               Int       @id @default(autoincrement())
  userId           Int       @map("user_id")
  date             DateTime 
  clockIn          DateTime  @map("clock_in")
  clockOut         DateTime? @map("clock_out")
  clockInLocation  String?   @map("clock_in_location")
  clockOutLocation String?   @map("clock_out_location")
  clockInPhoto     String?   @db.Text @map("clock_in_photo")
  clockOutPhoto    String?   @db.Text @map("clock_out_photo")
  clockInIp        String?   @map("clock_in_ip")
  clockOutIp       String?   @map("clock_out_ip")
  status           String    @default("PRESENT")
  lateMinutes      Int       @default(0) @map("late_minutes")
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@index([status])
  @@index([userId, date])
  @@index([createdAt])
  @@map("attendance")
}

model SystemConfig {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_config")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  details    String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Leave {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  type      String   @default("SICK")
  reason    String
  status    String   @default("PENDING")
  proof     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([userId, status])
  @@index([createdAt])
  @@map("leaves")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  title     String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  type      String   @default("INFO")
  link      String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model ShiftSwap {
  id            Int       @id @default(autoincrement())
  requesterId   Int       @map("requester_id")
  targetUserId  Int       @map("target_user_id")
  date          DateTime
  status        String    @default("PENDING_VALIDATION")
  reason        String?
  rejectionNote String?   @map("rejection_note")
  approverId    Int?      @map("approver_id")
  respondedAt   DateTime? @map("responded_at")
  approvedAt    DateTime? @map("approved_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  requester User @relation("Requester", fields: [requesterId], references: [id])
  target    User @relation("Target", fields: [targetUserId], references: [id])
  approver  User? @relation("ShiftSwapApprover", fields: [approverId], references: [id])

  @@index([requesterId])
  @@index([targetUserId])
  @@index([date])
  @@index([status])
  @@index([requesterId, status])
  @@index([createdAt])
  @@map("shift_swaps")
}

model OffDayRequest {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  targetUserId  Int?      @map("target_user_id")
  offDate       DateTime  @map("off_date")
  workDate      DateTime  @map("work_date")
  reason        String?
  status        String    @default("PENDING_VALIDATION")
  rejectionNote String?   @map("rejection_note")
  approverId    Int?      @map("approver_id")
  respondedAt   DateTime? @map("responded_at")
  approvedAt    DateTime? @map("approved_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user     User? @relation(fields: [userId], references: [id])
  target   User? @relation("OffDaySwapTarget", fields: [targetUserId], references: [id])
  approver User? @relation("OffDayApprover", fields: [approverId], references: [id])

  @@index([userId])
  @@index([targetUserId])
  @@index([status])
  @@index([userId, status])
  @@index([createdAt])
  @@map("off_day_requests")
}

model UserSchedule {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  date      DateTime
  shiftId   Int?     @map("shift_id")
  isOffDay  Boolean  @default(false) @map("is_off_day")
  kitchenStation String? @map("kitchen_station")
  isInventoryController Boolean @default(false) @map("is_inventory_controller")
  isShiftPic           Boolean @default(false) @map("is_shift_pic")
  isSanitationLead     Boolean @default(false) @map("is_sanitation_lead")
  isManualOverride     Boolean @default(false) @map("is_manual_override")
  temporaryDepartment  String? @map("temporary_department") // BAR, KITCHEN — override for this day only

  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  shift   Shift? @relation(fields: [shiftId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("user_schedules")
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model PublicHoliday {
  id          Int      @id @default(autoincrement())
  date        DateTime @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([date])
  @@map("public_holidays")
}

model Overtime {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  date        DateTime
  startTime   DateTime @map("start_time")
  endTime     DateTime @map("end_time")
  durationHours Float   @map("duration_hours")
  reason      String?
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedById Int?    @map("approved_by_id")
  approvedAt  DateTime? @map("approved_at")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user       User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User? @relation("OvertimeApprover", fields: [approvedById], references: [id])

  @@index([userId])
  @@index([date])
  @@index([status])
  @@index([userId, status])
  @@index([createdAt])
  @@map("overtime")
}

model Position {
  id             Int     @id @default(autoincrement())
  name           String  @unique
  shift1Capacity Int     @default(2) @map("shift1_capacity")
  shift2Capacity Int     @default(3) @map("shift2_capacity")
  isActive       Boolean @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  rosters        PositionRoster[]
  rotationStates RotationState[]
  weeklySchedules WeeklySchedule[]

  @@map("positions")
}

model PositionRoster {
  id         Int     @id @default(autoincrement())
  positionId Int     @map("position_id")
  userId     Int     @map("user_id")
  orderIndex Int     @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([positionId, orderIndex])
  @@unique([positionId, userId])
  @@index([userId])
  @@map("position_rosters")
}

model RotationState {
  id                    Int      @id @default(autoincrement())
  positionId            Int      @unique @map("position_id")
  currentStartIndex     Int      @default(0) @map("current_start_index")
  lastGeneratedWeekStart DateTime? @map("last_generated_week_start")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("rotation_states")
}

model WeeklySchedule {
  id          Int      @id @default(autoincrement())
  positionId  Int      @map("position_id")
  weekStart   DateTime @map("week_start")
  userId      Int      @map("user_id")
  shiftNumber Int      @map("shift_number")
  isGenerated Boolean  @default(true) @map("is_generated")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([positionId, weekStart, userId])
  @@index([positionId, weekStart])
  @@index([userId, weekStart])
  @@map("weekly_schedules")
}
