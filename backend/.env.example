PORT=3001
NODE_ENV=development
# Lokal: install MySQL dan buat database `absensi_cafe`, lalu ganti URL di bawah.
# Contoh TiDB Cloud: mysql://user:pass@gateway.xxx.tidbcloud.com:4000/absensi_cafe?sslaccept=strict
DATABASE_URL="mysql://root:password@localhost:3306/absensi_cafe"
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=24h
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
