# Template database TEST/STAGING.
# Salin: cp .env.test.example .env.test  (PowerShell: Copy-Item .env.test.example .env.test)
# File .env.test TIDAK di-commit (berisi kredensial).
#
# ATURAN UTAMA: DATABASE_URL di sini WAJIB menunjuk DB staging/dev,
# JANGAN DB produksi yang dipakai backend/.env.
#
# Jalankan perintah dengan env ini:
#   npm run test:staging
#   node scripts/with-test-db.js node tmp_script.cjs

DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/absensi_cafe_staging"
PORT=3002
NODE_ENV=test
JWT_SECRET="secret-khusus-test-minimal-32-karakter-ganti-ini"
JWT_EXPIRES_IN=24h
CORS_ALLOWED_ORIGINS=http://localhost:3000
