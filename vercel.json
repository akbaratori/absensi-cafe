{
  "version": 2,
  "installCommand": "npm install && cd backend && npm install && cd ../frontend && npm install --include=dev",
  "buildCommand": "cd frontend && npm run build && cd ../backend && npx prisma generate --schema=./prisma/schema.prisma",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "backend/src/**,backend/node_modules/.prisma/**,backend/node_modules/@prisma/client/**,backend/prisma/schema.prisma,backend/prisma/migrations/**,backend/package.json"
    }
  },
  "rewrites": [
    {
      "source": "/api/cron/(.*)",
      "destination": "/api/cron/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}